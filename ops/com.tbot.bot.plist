<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd keeps the bot alive. KeepAlive=true restarts it however it exits:
  crash, kill -9, or an unhandled exception. RunAtLoad starts it at login.

  The engine has its own restart-storm detection: more than
  engine.max_restarts_per_hour restarts and it drops to safe mode (existing
  positions still managed, no new entries) rather than thrashing.

  Install:
    cp ops/com.tbot.bot.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.tbot.bot.plist
  Stop (this is the "manual shutdown" the design refers to):
    launchctl unload -w ~/Library/LaunchAgents/com.tbot.bot.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tbot.bot</string>

  <key>ProgramArguments</key>
  <array>
    <!-- caffeinate -i: prevents idle sleep while the bot runs. Crypto trades
         around the clock; a sleeping Mac is a bot that is not running, and an
         open position whose stop lives only in this process is unprotected. -->
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/necipfazilakay/Documents/PROJECTS/TRADING-BOT/.venv/bin/python</string>
    <string>/Users/necipfazilakay/Documents/PROJECTS/TRADING-BOT/scripts/run.py</string>
    <string>--config</string>
    <string>config/paper.yaml</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/necipfazilakay/Documents/PROJECTS/TRADING-BOT</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Back off between restarts so a persistent failure does not spin the CPU. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/necipfazilakay/Documents/PROJECTS/TRADING-BOT/runtime/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/necipfazilakay/Documents/PROJECTS/TRADING-BOT/runtime/logs/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <false/>
</dict>
</plist>
